{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pomodo",
  "version": "0.1.0",
  "identifier": "com.pomodo.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Momo",
        "width": 1180,
        "height": 700,
        "minWidth": 1180,
        "minHeight": 660,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      },
      {
        "label": "prefs",
        "url": "prefs.html",
        "title": "\u8bbe\u7f6e",
        "width": 1180,
        "height": 640,
        "minWidth": 1180,
        "minHeight": 606,
        "visible": false,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
