{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pomodo",
  "version": "0.1.0",
  "identifier": "com.pomodo.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Pomodo",
        "width": 1180,
        "height": 700,
        "minWidth": 1180,
        "minHeight": 660,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 24
        }
      },
      {
        "label": "prefs",
        "url": "prefs.html",
        "title": "\u8bbe\u7f6e",
        "width": 1180,
        "height": 640,
        "minWidth": 1180,
        "minHeight": 606,
        "visible": false,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 24
        }
      },
      {
        "label": "tray",
        "url": "tray.html",
        "width": 330,
        "height": 340,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false
      },
      {
        "label": "pet",
        "url": "pet.html",
        "width": 380,
        "height": 200,
        "focus": false,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false
      },
      {
        "label": "bubble",
        "url": "bubble.html",
        "width": 360,
        "height": 110,
        "focus": false,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
